import "./style.css";
import { Badge } from "@elements/ui/badge";
import { RentRow } from "#app/shared/services/rent";
import { day } from "#app/shared/format";

export const METHOD_LABEL: Record<string, string> = {
  card: "Card",
  autopay: "Autopay",
  check: "Check",
  cash: "Cash",
  transfer: "Bank transfer",
};

export function paidOn(row: RentRow): string {
  if (!row.paidAt) {
    return "";
  }

  return row.paidAt.toLocaleDateString("en-US", { month: "short", day: "numeric" });
}

<RentStatus (row: RentRow)>
  <span e:switch={row.state} class="rent-status">
    <Badge e:case="paid" variant="success" dot>Paid</Badge>
    <Badge e:case="processing" variant="info" dot>Processing</Badge>
    <Badge e:case="late" variant="danger" dot>Late · {row.daysLate}d</Badge>
    <Badge e:default variant="warning" dot>Due {day(row.dueDate)}</Badge>
  </span>
</RentStatus>
