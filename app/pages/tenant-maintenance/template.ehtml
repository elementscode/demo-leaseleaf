import "./style.css";
import { File, FieldErrors, LiveView, ValidationError, redirect } from "@elements/app";
import { Alert } from "@elements/ui/alert";
import { Button } from "@elements/ui/button";
import { Card, CardContent } from "@elements/ui/card";
import { Empty } from "@elements/ui/empty";
import { Field, FieldContent, FieldDescription, FieldLabel, FieldLegend, FieldSet, FieldTitle } from "@elements/ui/field";
import { FileUpload } from "@elements/ui/file-upload";
import { Input } from "@elements/ui/input";
import { RadioGroup, RadioGroupItem } from "@elements/ui/radio-group";
import { Textarea } from "@elements/ui/textarea";
import favicon from "#app/shared/assets/favicons/favicon.svg";
import { AppShell } from "#app/shared/templates/app-shell";
import { RequestCard } from "#app/shared/templates/request-card";
import { RequestRow } from "#app/shared/services/maintenance";
import { MAX_PHOTOS, RequestForm, submitRequest } from "./services";

interface Ui {
  busy: boolean;
  error: string;
}

const URGENCY_OPTIONS = [
  { value: "low", label: "Low", hint: "Whenever is convenient" },
  { value: "normal", label: "Normal", hint: "Within a few days" },
  { value: "urgent", label: "Urgent", hint: "No heat, water or a leak" },
];

function emptyForm(): RequestForm {
  return { title: "", description: "", urgency: "normal", photos: [] as File[] };
}

function onSubmit(form: RequestForm, ui: Ui): FieldErrors<RequestForm> {
  ui.busy = true;
  ui.error = "";

  try {
    let id = submitRequest(form);
    redirect(`/maintenance/${id}`);
    return {};
  } catch (err: any) {
    ui.busy = false;

    if (err instanceof ValidationError) {
      if (err.errors) {
        return err.errors;
      }

      ui.error = err.message;
      return {};
    }

    ui.error = err.message;
    return {};
  }
}

function open(requests: LiveView<RequestRow>): RequestRow[] {
  return requests.filter((r) => r.status !== "done").sort((a, b) => +b.createdAt - +a.createdAt);
}

function closed(requests: LiveView<RequestRow>): RequestRow[] {
  return requests.filter((r) => r.status === "done").sort((a, b) => +b.createdAt - +a.createdAt);
}

<html lang="en" class="page-tenant-maintenance" (
  requests: LiveView<RequestRow>,
  private form: RequestForm = emptyForm(),
  private errors: FieldErrors<RequestForm> = {},
  private ui: Ui = { busy: false, error: "" },
)>
  <head>
    <title>Maintenance · Leaseleaf</title>
    <link rel="icon" type="image/svg+xml" href={favicon} />
  </head>
  <body>
    <AppShell active="maintenance">
      <div class="page-shell stack is-xl">
        <div class="stack is-xs">
          <h1>Maintenance</h1>
          <p class="lede">Tell us what needs fixing. Photos help us bring the right parts.</p>
        </div>

        <div class="tm-grid">
          <section id="new">
            <Card title="New request" level={2}>
              <CardContent>
                <form class="stack" onsubmit={() => errors = onSubmit(form, ui)}>
                  <Alert e:if={ui.error} variant="danger" description={ui.error} />

                  <Field label="What is wrong?" errors={errors.title ?? []}>
                    <Input value={form.title} placeholder="e.g. Bathroom sink is clogged" attrs={{ maxlength: 120 }} />
                  </Field>

                  <Field label="Details" errors={errors.description ?? []}>
                    <Textarea value={form.description} rows={4} placeholder="Where is it, when did it start, and anything you have tried." />
                  </Field>

                  <FieldSet>
                    <FieldLegend variant="label">Urgency</FieldLegend>
                    <RadioGroup value={form.urgency} name="urgency" class="urgency-options" attrs={{ "aria-label": "Urgency" }}>
                      <FieldLabel e:for={opt of URGENCY_OPTIONS}>
                        <Field orientation="horizontal" reserveError={false}>
                          <RadioGroupItem value={opt.value} />
                          <FieldContent>
                            <FieldTitle>{opt.label}</FieldTitle>
                            <FieldDescription>{opt.hint}</FieldDescription>
                          </FieldContent>
                        </Field>
                      </FieldLabel>
                    </RadioGroup>
                    <p e:for={msg of errors.urgency ?? []} class="error">{msg}</p>
                  </FieldSet>

                  <Field label="Photos" errors={errors.photos ?? []}>
                    <FileUpload files={form.photos} accept="image/*" maxFiles={MAX_PHOTOS} hint={`Add up to ${MAX_PHOTOS} photos`} />
                  </Field>

                  <Button type="submit" variant="primary" block loading={ui.busy}>Send request</Button>
                </form>
              </CardContent>
            </Card>
          </section>

          <section class="stack is-lg">
            <div class="stack">
              <h2 class="tm-section-title">Open</h2>
              <div e:if={open(requests).length > 0} class="stack is-sm">
                <RequestCard e:for={r of open(requests)} request={r} showTenant={false} showStatus={true} />
              </div>
              <Empty e:else variant="outline" description="No open requests. Everything is working." />
            </div>

            <div e:if={closed(requests).length > 0} class="stack">
              <h2 class="tm-section-title">Done</h2>
              <div class="stack is-sm">
                <RequestCard e:for={r of closed(requests)} request={r} showTenant={false} showStatus={true} />
              </div>
            </div>
          </section>
        </div>
      </div>
    </AppShell>
  </body>
</html>
