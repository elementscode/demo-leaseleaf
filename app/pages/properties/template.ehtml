import "./style.css";
import { FieldErrors, ValidationError } from "@elements/app";
import { Alert } from "@elements/ui/alert";
import { Badge } from "@elements/ui/badge";
import { Button } from "@elements/ui/button";
import { Card, CardAction, CardContent } from "@elements/ui/card";
import { DatePicker } from "@elements/ui/date-picker";
import { Field } from "@elements/ui/field";
import { Input } from "@elements/ui/input";
import { NumberInput } from "@elements/ui/number-input";
import { Table, TableCell, TableHead } from "@elements/ui/table";
import favicon from "#app/shared/assets/favicons/favicon.svg";
import { AppShell } from "#app/shared/templates/app-shell";
import { ordinal, rent, day } from "#app/shared/format";
import {
  BuildingForm,
  BuildingRow,
  InviteForm,
  UnitForm,
  UnitRow,
  addBuilding,
  addUnit,
  cancelInvite,
  inviteTenant,
  resendInvite,
} from "./services";

interface State {
  buildings: BuildingRow[];
  inviting: string;
  addingUnit: string;
  addingBuilding: boolean;
  links: Record<string, string>;
  copied: string;
  notice: string;
  error: string;
}

function firstOfNextMonth(): string {
  let d = new Date();
  let next = new Date(d.getFullYear(), d.getMonth() + 1, 1);

  return `${next.getFullYear()}-${String(next.getMonth() + 1).padStart(2, "0")}-01`;
}

function emptyInvite(unitId: string): InviteForm {
  return { unitId, name: "", email: "", rent: 0, dueDay: 1, startDate: firstOfNextMonth() };
}

function allUnits(state: State): UnitRow[] {
  return state.buildings.flatMap((b) => b.units);
}

function occupied(state: State): number {
  return allUnits(state).filter((u) => u.leaseStatus === "active").length;
}

function monthlyRent(state: State): number {
  return allUnits(state).filter((u) => u.leaseStatus === "active").reduce((sum, u) => sum + (u.rentCents ?? 0), 0);
}

function linkFor(state: State, unit: UnitRow): string {
  if (unit.leaseId && state.links[unit.leaseId]) {
    return state.links[unit.leaseId];
  }

  return unit.inviteId ? `${location.origin}/invite/${unit.inviteId}` : "";
}

function onInvite(state: State, form: InviteForm): FieldErrors<InviteForm> {
  state.error = "";

  try {
    let result = inviteTenant(form);
    let unit = result.buildings.flatMap((b) => b.units).find((u) => u.id === form.unitId);

    state.buildings = result.buildings;
    state.inviting = "";
    state.notice = `Invite sent to ${form.email}. You can also share the link below.`;

    if (unit?.leaseId) {
      state.links[unit.leaseId] = result.url;
    }

    return {};
  } catch (err: any) {
    if (err instanceof ValidationError && err.errors) {
      return err.errors;
    }

    state.error = err.message;
    return {};
  }
}

function onResend(state: State, unit: UnitRow) {
  state.error = "";

  try {
    let result = resendInvite(unit.leaseId!);
    state.buildings = result.buildings;
    state.links[unit.leaseId!] = result.url;
    state.notice = `A fresh invite is on its way to ${unit.tenantEmail}.`;
  } catch (err: any) {
    state.error = err.message;
  }
}

function onCancel(state: State, unit: UnitRow) {
  state.error = "";

  try {
    state.buildings = cancelInvite(unit.leaseId!);
    state.notice = `Invite for ${unit.tenantName} cancelled. Unit ${unit.label} is vacant again.`;
  } catch (err: any) {
    state.error = err.message;
  }
}

async function onCopy(state: State, url: string, key: string) {
  await navigator.clipboard.writeText(url);
  state.copied = key;
}

function onAddUnit(state: State, form: UnitForm): FieldErrors<UnitForm> {
  try {
    state.buildings = addUnit(form);
    state.addingUnit = "";
    return {};
  } catch (err: any) {
    if (err instanceof ValidationError && err.errors) {
      return err.errors;
    }

    state.error = err.message;
    return {};
  }
}

function onAddBuilding(state: State, form: BuildingForm): FieldErrors<BuildingForm> {
  try {
    state.buildings = addBuilding(form);
    state.addingBuilding = false;
    return {};
  } catch (err: any) {
    if (err instanceof ValidationError && err.errors) {
      return err.errors;
    }

    state.error = err.message;
    return {};
  }
}

<InviteRow (state: State, unit: UnitRow, private form: InviteForm = emptyInvite(unit.id), private errors: FieldErrors<InviteForm> = {})>
  <tr class="invite-row">
    <TableCell colspan={6}>
      <form class="invite-form" onsubmit={() => errors = onInvite(state, form)}>
        <Field label="Tenant name" errors={errors.name ?? []}>
          <Input value={form.name} attrs={{ autocomplete: "off" }} />
        </Field>
        <Field label="Email" errors={errors.email ?? []}>
          <Input type="email" value={form.email} attrs={{ autocapitalize: "none", spellcheck: "false" }} />
        </Field>
        <Field label="Monthly rent ($)" errors={errors.rent ?? []}>
          <NumberInput value={form.rent} step={1} buttons="none" />
        </Field>
        <Field label="Rent due on day" errors={errors.dueDay ?? []}>
          <NumberInput value={form.dueDay} min={1} max={28} buttons="none" />
        </Field>
        <Field label="Lease starts" errors={errors.startDate ?? []}>
          <DatePicker value={form.startDate} block />
        </Field>
        <div class="invite-actions row">
          <Button variant="ghost" onclick={() => state.inviting = ""}>Cancel</Button>
          <Button type="submit" variant="primary">Send invite</Button>
        </div>
      </form>
    </TableCell>
  </tr>
</InviteRow>

<UnitLine (state: State, unit: UnitRow)>
  <tr>
    <TableCell>
      <span class="unit-label">{unit.label}</span>
      <span class="unit-size">{unit.bedrooms} bd · {unit.bathrooms} ba</span>
    </TableCell>
    <TableCell>
      <div e:if={unit.leaseStatus} class="tenant-cell">
        <span>{unit.tenantName}</span>
        <small>{unit.tenantEmail}</small>
      </div>
      <span e:else class="vacant">Vacant</span>
    </TableCell>
    <TableCell align="end" class="hide-sm">{unit.rentCents ? rent(unit.rentCents) : ""}</TableCell>
    <TableCell class="hide-sm">{unit.dueDay ? `The ${ordinal(unit.dueDay)}` : ""}</TableCell>
    <TableCell>
      <div class="cluster is-xs">
        <Badge e:if={unit.leaseStatus === "active"} variant="success">Active</Badge>
        <Badge e:elseif={unit.leaseStatus === "invited"} variant="warning">Invited</Badge>
        <Badge e:else variant="secondary">Vacant</Badge>
        <Badge e:if={unit.autopay} variant="accent">Autopay</Badge>
        <Badge e:if={unit.owedCents > 0} variant="danger">Owes {rent(unit.owedCents)}</Badge>
        <Badge e:if={unit.openRequests > 0} variant="info" href="/landlord/maintenance">{unit.openRequests} open {unit.openRequests === 1 ? "repair" : "repairs"}</Badge>
      </div>
    </TableCell>
    <TableCell>
      <div class="unit-actions row">
        <Button e:if={!unit.leaseStatus && state.inviting !== unit.id} size="sm" variant="primary" onclick={() => state.inviting = unit.id}>
          Invite tenant
        </Button>
        <span e:if={unit.leaseStatus === "active" && unit.startDate} class="hint">Since {day(unit.startDate!, true)}</span>
        <Button e:if={unit.leaseStatus === "invited"} size="sm" onclick={() => onResend(state, unit)}>Resend</Button>
        <Button e:if={unit.leaseStatus === "invited"} size="sm" variant="ghost" onclick={() => onCancel(state, unit)}>Cancel</Button>
      </div>
    </TableCell>
  </tr>
  <tr e:if={unit.leaseStatus === "invited" && linkFor(state, unit)} class="invite-row">
    <TableCell colspan={6}>
      <div class="invite-link row">
        <span class="hint">Invite link</span>
        <code>{linkFor(state, unit)}</code>
        <Button size="sm" onclick={() => onCopy(state, linkFor(state, unit), unit.id)}>
          {state.copied === unit.id ? "Copied" : "Copy"}
        </Button>
      </div>
    </TableCell>
  </tr>
  <InviteRow e:if={state.inviting === unit.id} {state} {unit} />
</UnitLine>

<AddUnit (state: State, building: BuildingRow, private form: UnitForm = { buildingId: building.id, label: "", bedrooms: 1, bathrooms: 1 }, private errors: FieldErrors<UnitForm> = {})>
  <form class="inline-form" onsubmit={() => errors = onAddUnit(state, form)}>
    <Field reserveError={false} label="Unit" errors={errors.label ?? []}>
      <Input value={form.label} placeholder="e.g. 3B" />
    </Field>
    <Field reserveError={false} label="Bedrooms" errors={errors.bedrooms ?? []}>
      <NumberInput value={form.bedrooms} min={0} max={10} buttons="none" />
    </Field>
    <Field reserveError={false} label="Bathrooms" errors={errors.bathrooms ?? []}>
      <NumberInput value={form.bathrooms} min={0.5} max={10} step={0.5} buttons="none" />
    </Field>
    <div class="form-actions row">
      <Button variant="ghost" onclick={() => state.addingUnit = ""}>Cancel</Button>
      <Button type="submit" variant="primary">Add unit</Button>
    </div>
  </form>
</AddUnit>

<AddBuilding (state: State, private form: BuildingForm = { name: "", address: "" }, private errors: FieldErrors<BuildingForm> = {})>
  <section>
    <Card title="New building" level={2}>
      <CardContent>
        <form class="building-form" onsubmit={() => errors = onAddBuilding(state, form)}>
          <Field reserveError={false} label="Name" errors={errors.name ?? []}>
            <Input value={form.name} placeholder="e.g. Cedar Flats" />
          </Field>
          <Field reserveError={false} label="Address" errors={errors.address ?? []}>
            <Input value={form.address} placeholder="Street address" />
          </Field>
          <div class="form-actions row">
            <Button variant="ghost" onclick={() => state.addingBuilding = false}>Cancel</Button>
            <Button type="submit" variant="primary">Add building</Button>
          </div>
        </form>
      </CardContent>
    </Card>
  </section>
</AddBuilding>

<html lang="en" class="page-properties" (
  initial: BuildingRow[],
  private state: State = { buildings: initial, inviting: "", addingUnit: "", addingBuilding: false, links: {}, copied: "", notice: "", error: "" },
)>
  <head>
    <title>Properties · Leaseleaf</title>
    <link rel="icon" type="image/svg+xml" href={favicon} />
  </head>
  <body>
    <AppShell active="properties">
      <div class="page-shell is-wide stack is-xl">
        <div class="props-head row">
          <div class="stack is-xs">
            <p class="eyebrow">Properties</p>
            <h1>Buildings and units</h1>
            <div class="props-summary cluster">
              <span><strong>{state.buildings.length}</strong> buildings</span>
              <span><strong>{occupied(state)}</strong> of {allUnits(state).length} units leased</span>
              <span><strong>{rent(monthlyRent(state))}</strong> monthly rent</span>
            </div>
          </div>
          <Button e:if={!state.addingBuilding} onclick={() => state.addingBuilding = true}>Add building</Button>
        </div>

        <Alert e:if={state.notice} variant="success" role="status" description={state.notice} />
        <Alert e:if={state.error} variant="danger" description={state.error} />

        <AddBuilding e:if={state.addingBuilding} {state} />

        <section e:for={building of state.buildings}>
          <Card>
            <div class="card-head building-head">
              <div class="stack is-xs">
                <h2>{building.name}</h2>
                <span class="building-address">{building.address}</span>
              </div>
              <CardAction>
                <Button e:if={state.addingUnit !== building.id} size="sm" variant="ghost" onclick={() => state.addingUnit = building.id}>Add unit</Button>
              </CardAction>
            </div>
            <CardContent class="stack">
              <AddUnit e:if={state.addingUnit === building.id} {state} {building} />

              <Table e:if={building.units.length > 0} label={`Units in ${building.name}`}>
                <table class="unit-table">
                  <thead>
                    <tr>
                      <TableHead>Unit</TableHead>
                      <TableHead>Tenant</TableHead>
                      <TableHead align="end" class="hide-sm">Rent</TableHead>
                      <TableHead class="hide-sm">Due</TableHead>
                      <TableHead>Status</TableHead>
                      <TableHead><span class="visually-hidden">Actions</span></TableHead>
                    </tr>
                  </thead>
                  <tbody>
                    <UnitLine e:for={unit of building.units} {state} {unit} />
                  </tbody>
                </table>
              </Table>
              <p e:else class="hint">No units yet. Add the first one.</p>
            </CardContent>
          </Card>
        </section>
      </div>
    </AppShell>
  </body>
</html>
