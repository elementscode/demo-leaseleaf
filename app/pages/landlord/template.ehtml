import "./style.css";
import { LiveView } from "@elements/app";
import { Alert } from "@elements/ui/alert";
import { Badge } from "@elements/ui/badge";
import { Button } from "@elements/ui/button";
import { Card, CardContent } from "@elements/ui/card";
import { DropdownMenu, DropdownMenuItem } from "@elements/ui/dropdown-menu";
import { Progress } from "@elements/ui/progress";
import { Table, TableCell, TableHead } from "@elements/ui/table";
import { Tabs, TabsContent, TabsList, TabsTrigger } from "@elements/ui/tabs";
import favicon from "#app/shared/assets/favicons/favicon.svg";
import { AppShell } from "#app/shared/templates/app-shell";
import { RentStatus, METHOD_LABEL, paidOn } from "#app/shared/templates/rent-status";
import { RentRow } from "#app/shared/services/rent";
import { day, monthName, rent } from "#app/shared/format";
import { OFFLINE_METHODS, OfflineMethod, recordPayment, runRentCycle } from "./services";

interface Ui {
  month: string;
  notice: string;
  error: string;
  busy: boolean;
}

function months(charges: LiveView<RentRow>): string[] {
  return [...new Set(charges.map((c) => c.month))].sort();
}

function rows(charges: LiveView<RentRow>, month: string): RentRow[] {
  return charges
    .filter((c) => c.month === month)
    .sort((a, b) => a.buildingName.localeCompare(b.buildingName) || a.unitLabel.localeCompare(b.unitLabel, undefined, { numeric: true }));
}

function earlierOwed(charges: LiveView<RentRow>, month: string): RentRow[] {
  return charges
    .filter((c) => c.month < month && c.state === "late")
    .sort((a, b) => a.dueDate.localeCompare(b.dueDate));
}

function lateList(charges: LiveView<RentRow>, month: string): RentRow[] {
  return charges.filter((c) => c.month <= month && c.state === "late");
}

function total(list: RentRow[], state?: RentRow["state"][]): number {
  return list.filter((c) => !state || state.includes(c.state)).reduce((sum, c) => sum + c.amountCents, 0);
}

function count(list: RentRow[], state: RentRow["state"]): number {
  return list.filter((c) => c.state === state).length;
}

function onRecord(ui: Ui, row: RentRow, method: OfflineMethod) {
  ui.error = "";

  try {
    recordPayment(row.id, method);
    ui.notice = `Recorded ${rent(row.amountCents)} from ${row.tenantName} by ${METHOD_LABEL[method].toLowerCase()}.`;
  } catch (err: any) {
    ui.error = err.message;
  }
}

function onRunCycle(ui: Ui) {
  ui.busy = true;
  ui.error = "";

  try {
    runRentCycle();
    ui.notice = "Today's rent run is going now: new charges, autopay, reminders due in three days and late notices.";
  } catch (err: any) {
    ui.error = err.message;
  }

  ui.busy = false;
}

<RollRow (row: RentRow, ui: Ui, showMonth: boolean = false)>
  <tr class={[row.state === "late" && "is-late"]}>
    <TableCell>
      <span class="roll-unit">{row.unitLabel}</span>
      <span class="roll-building">{row.buildingName}</span>
      <span class="roll-who">{row.tenantName}</span>
    </TableCell>
    <TableCell class="roll-tenant-cell">
      <span class="roll-tenant row">
        {row.tenantName}
        <Badge e:if={row.autopay} variant="accent" attrs={{ title: "Autopay is on" }}>Autopay</Badge>
      </span>
    </TableCell>
    <TableCell align="end">{rent(row.amountCents)}</TableCell>
    <TableCell class="hide-sm">{showMonth ? monthName(row.month, true) : day(row.dueDate)}</TableCell>
    <TableCell><RentStatus {row} /></TableCell>
    <TableCell class="hide-sm text-ink-soft">
      {row.paidAt ? `${paidOn(row)} · ${METHOD_LABEL[row.method ?? "card"] ?? row.method}` : ""}
    </TableCell>
    <TableCell align="end">
      <DropdownMenu e:if={row.state === "due" || row.state === "late"} align="end">
        <Button slot="trigger" variant="link" size="sm"><span>Record<span class="hide-sm"> payment</span></span></Button>
        <DropdownMenuItem e:for={m of OFFLINE_METHODS} onSelect={() => onRecord(ui, row, m)}>
          Paid by {METHOD_LABEL[m].toLowerCase()}
        </DropdownMenuItem>
      </DropdownMenu>
    </TableCell>
  </tr>
</RollRow>

<RollTable (list: RentRow[], ui: Ui, label: string, showMonth: boolean = false)>
  <Table {label} class="roll-table">
    <table>
      <thead>
        <tr>
          <TableHead>Unit</TableHead>
          <TableHead class="roll-tenant-cell">Tenant</TableHead>
          <TableHead align="end">Rent</TableHead>
          <TableHead class="hide-sm">{showMonth ? "Month" : "Due"}</TableHead>
          <TableHead>Status</TableHead>
          <TableHead class="hide-sm">Paid</TableHead>
          <TableHead><span class="visually-hidden">Actions</span></TableHead>
        </tr>
      </thead>
      <tbody>
        <RollRow e:for={row of list} {row} {ui} {showMonth} />
      </tbody>
    </table>
  </Table>
</RollTable>

<MonthPanel (charges: LiveView<RentRow>, month: string, ui: Ui)>
  <div class="stack is-xl">
    <div class="stats">
      <Card class="stat">
        <span class="stat-label">Collected</span>
        <span class="stat-value">{rent(total(rows(charges, month), ["paid"]))}</span>
        <Progress value={total(rows(charges, month), ["paid"])} max={total(rows(charges, month)) || 1} size="sm" attrs={{ "aria-label": "Rent collected" }} />
        <span class="hint">of {rent(total(rows(charges, month)))} expected</span>
      </Card>
      <Card class="stat">
        <span class="stat-label">Paid</span>
        <span class="stat-value">{count(rows(charges, month), "paid")} <span class="text-ink-soft text-base">of {rows(charges, month).length}</span></span>
        <span class="hint">{count(rows(charges, month), "processing") > 0 ? `${count(rows(charges, month), "processing")} processing` : "units"}</span>
      </Card>
      <Card class="stat">
        <span class="stat-label">Due</span>
        <span class="stat-value">{rent(total(rows(charges, month), ["due"]))}</span>
        <span class="hint">{count(rows(charges, month), "due")} not yet due</span>
      </Card>
      <Card class="stat">
        <span class="stat-label">Late</span>
        <span class={["stat-value", lateList(charges, month).length > 0 && "is-danger"]}>
          {rent(total(lateList(charges, month)))}
        </span>
        <span class="hint">{lateList(charges, month).length} past due, earlier months included</span>
      </Card>
    </div>

    <section>
      <Card title={monthName(month)} level={2}>
        <span slot="action" class="hint">Updates live as tenants pay</span>
        <CardContent>
          <RollTable list={rows(charges, month)} {ui} label={`Rent for ${monthName(month)}`} />
          <p e:if={rows(charges, month).length === 0} class="hint">No charges for this month.</p>
        </CardContent>
      </Card>
    </section>

    <section e:if={earlierOwed(charges, month).length > 0}>
      <Card title="Still owed from earlier months" level={2}>
        <Badge slot="action" variant="danger">{rent(total(earlierOwed(charges, month)))}</Badge>
        <CardContent>
          <RollTable list={earlierOwed(charges, month)} {ui} label="Still owed from earlier months" showMonth={true} />
        </CardContent>
      </Card>
    </section>
  </div>
</MonthPanel>

<html lang="en" class="page-landlord" (
  charges: LiveView<RentRow>,
  month: string,
  private ui: Ui = { month, notice: "", error: "", busy: false },
)>
  <head>
    <title>Rent roll · Leaseleaf</title>
    <link rel="icon" type="image/svg+xml" href={favicon} />
  </head>
  <body>
    <AppShell active="rent">
      <div class="page-shell is-wide stack is-xl">
        <div class="roll-head row">
          <div class="stack is-xs">
            <p class="eyebrow">Rent roll</p>
            <h1>{monthName(ui.month)}</h1>
          </div>
          <Button size="sm" loading={ui.busy} onclick={() => onRunCycle(ui)}>
            Send due reminders and late notices now
          </Button>
        </div>

        <Alert e:if={ui.notice} variant="success" role="status" description={ui.notice} />
        <Alert e:if={ui.error} variant="danger" description={ui.error} />

        <Tabs value={ui.month}>
          <TabsList label="Month">
            <TabsTrigger e:for={m of months(charges)} value={m}>{monthName(m, true)}</TabsTrigger>
          </TabsList>
          <TabsContent e:for={m of months(charges)} value={m}>
            <MonthPanel {charges} month={m} {ui} />
          </TabsContent>
        </Tabs>
      </div>
    </AppShell>
  </body>
</html>
