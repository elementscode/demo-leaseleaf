import "./style.css";
import { LiveView } from "@elements/app";
import { Badge } from "@elements/ui/badge";
import { Empty } from "@elements/ui/empty";
import { Kanban, KanbanBoard, KanbanColumn, KanbanItem, KanbanNav, KanbanNavItem } from "@elements/ui/kanban";
import favicon from "#app/shared/assets/favicons/favicon.svg";
import { AppShell } from "#app/shared/templates/app-shell";
import { RequestCard } from "#app/shared/templates/request-card";
import { RequestRow, RequestStatus, STATUSES, STATUS_LABEL } from "#app/shared/services/maintenance";

const URGENCY_RANK = { urgent: 0, normal: 1, low: 2 };

const EMPTY: Record<RequestStatus, string> = {
  new: "Nothing new. Tenants' requests land here.",
  scheduled: "No visits booked.",
  done: "Nothing finished yet.",
};

/** New and scheduled work sorts by urgency, then age; done work by when it finished. */
function lane(requests: LiveView<RequestRow>, status: RequestStatus): RequestRow[] {
  let list = requests.filter((r) => r.status === status);

  if (status === "done") {
    return list.sort((a, b) => +(b.completedAt ?? b.updatedAt) - +(a.completedAt ?? a.updatedAt)).slice(0, 12);
  }

  if (status === "scheduled") {
    return list.sort((a, b) => (a.scheduledFor ?? "").localeCompare(b.scheduledFor ?? ""));
  }

  return list.sort((a, b) => URGENCY_RANK[a.urgency] - URGENCY_RANK[b.urgency] || +a.createdAt - +b.createdAt);
}

function lanes(requests: LiveView<RequestRow>): Record<RequestStatus, RequestRow[]> {
  return { new: lane(requests, "new"), scheduled: lane(requests, "scheduled"), done: lane(requests, "done") };
}

function urgentOpen(requests: LiveView<RequestRow>): number {
  return requests.filter((r) => r.urgency === "urgent" && r.status !== "done").length;
}

<html lang="en" class="page-landlord-maintenance" (requests: LiveView<RequestRow>)>
  <head>
    <title>Maintenance · Leaseleaf</title>
    <link rel="icon" type="image/svg+xml" href={favicon} />
  </head>
  <body>
    <AppShell active="maintenance">
      <div class="page-shell is-wide stack is-xl">
        <div class="board-head row">
          <div class="stack is-xs">
            <p class="eyebrow">Maintenance</p>
            <h1>Repair queue</h1>
          </div>
          <div class="cluster is-sm">
            <Badge e:if={urgentOpen(requests) > 0} variant="danger" dot>{urgentOpen(requests)} urgent</Badge>
            <Badge variant="secondary">{requests.filter((r) => r.status !== "done").length} open</Badge>
          </div>
        </div>

        <Kanban value={lanes(requests)} label="Repair queue" class="board">
          <KanbanNav label="Lanes">
            <KanbanNavItem e:for={status of STATUSES} value={status}>{STATUS_LABEL[status]}</KanbanNavItem>
          </KanbanNav>
          <KanbanBoard>
            <KanbanColumn e:for={status of STATUSES}
                          value={status}
                          title={STATUS_LABEL[status]}
                          count={requests.filter((r) => r.status === status).length}>
              <KanbanItem e:for={r of lane(requests, status)}
                          value={r.id}
                          label={r.title}
                          class={r.urgency === "urgent" && r.status !== "done" ? "is-urgent" : ""}>
                <RequestCard request={r} bare />
              </KanbanItem>
              <Empty e:if={lane(requests, status).length === 0} variant="outline" description={EMPTY[status]} />
            </KanbanColumn>
          </KanbanBoard>
        </Kanban>
      </div>
    </AppShell>
  </body>
</html>
